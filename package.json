{
  "name": "toposmith",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TopoSmith — 浏览器内的网络拓扑绘制与连通性推演器",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @toposmith/web dev",
    "build": "pnpm --filter @toposmith/web build",
    "preview": "pnpm --filter @toposmith/web preview",
    "typecheck": "pnpm -r --sequential typecheck",
    "test": "pnpm --filter @toposmith/engine test",
    "test:web": "pnpm --filter @toposmith/web test",
    "check": "pnpm typecheck && pnpm test && pnpm test:web",
    "brand": "node scripts/build-brand.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
